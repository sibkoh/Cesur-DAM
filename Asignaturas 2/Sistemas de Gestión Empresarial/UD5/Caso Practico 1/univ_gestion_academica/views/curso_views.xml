<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_curso_list" model="ir.ui.view">
        <field name="name">univ.curso.list</field>
        <field name="model">univ.curso</field>
        <field name="arch" type="xml">
            <list string="Listado de Cursos">
                <field name="name"/>
                <field name="fecha_inicio"/>
                <field name="fecha_fin"/>
            </list>
        </field>
    </record>

    <record id="view_curso_form" model="ir.ui.view">
        <field name="name">univ.curso.form</field>
        <field name="model">univ.curso</field>
        <field name="arch" type="xml">
            <form string="Ficha del Curso">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Nombre del Curso"/>
                        <h1><field name="name" placeholder="Ej. Grado en Informática..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="fecha_inicio"/>
                            <field name="fecha_fin"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Asignaturas del Curso">
                            <field name="asignatura_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Descripción Detallada">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>